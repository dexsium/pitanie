<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.pitanie.pitanie_widgets.PitanieSmallWidget"
            android:exported="false"
            android:label="@string/pw_name_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pitanie_widget_small_info" />
        </receiver>
        <receiver
            android:name="com.pitanie.pitanie_widgets.PitanieMediumWidget"
            android:exported="false"
            android:label="@string/pw_name_medium">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pitanie_widget_medium_info" />
        </receiver>
    </application>
</manifest>
