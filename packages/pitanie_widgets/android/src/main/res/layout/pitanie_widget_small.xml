<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pw_background"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/pw_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pw_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pw_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pw_main_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="3dp"
                android:textColor="@color/pw_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pw_kcal_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="@color/pw_track"
            android:progressTint="@color/pw_accent" />

        <TextView
            android:id="@+id/pw_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/pw_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pw_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:textColor="@color/pw_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
